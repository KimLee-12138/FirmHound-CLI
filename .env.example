# Model runtime (optional; mock runtime is the default baseline)
# FSA_MODEL_PROVIDER=openai_compatible
# FSA_MODEL_API_KEY=your-key-here
# FSA_MODEL_BASE_URL=https://api.example.com/v1
# FSA_MODEL_NAME=deepseek-chat

# Token budget
# FSA_MAX_TOKENS_PER_RUN=100000
# FSA_MAX_CALLS_PER_STAGE=20

# Working directories (absolute or relative to project root)
FSA_RUNS_DIR=./runs
FSA_TEMP_DIR=./tmp

# Linux-only tool paths (used inside Docker/WSL)
# FSA_BINWALK_PATH=/usr/bin/binwalk
# FSA_GHIDRA_HEADLESS=/opt/ghidra/support/analyzeHeadless
